# Cloudflare R2 配置样例（复制为项目根的 cloudflare.env）
#
# 本 skill 只用到下面三项；若同目录已有 Mux / Stream 的 cloudflare.env，
# 直接把这三项补齐即可复用，无需另建文件。
# 该文件应加入 .gitignore，切勿提交。

# rclone 用的桶名
CLOUDFLARE_R2_BUCKET=<bucket-name>

# R2 子目录前缀。留空表示桶根；填 test/winnie/hls 表示在该前缀下隔离
CLOUDFLARE_R2_PREFIX=

# 桶的公共访问域名（bucket -> Settings -> Public access -> R2.dev 或自定义域名）
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-<hash>.r2.dev

# 以下与 rclone.conf 保持一致，脚本本身不读，留作对照
CLOUDFLARE_ACCOUNT_ID=<your-account-id>
CLOUDFLARE_R2_ACCESS_KEY=<r2-access-key-id>
CLOUDFLARE_R2_SECRET=<r2-secret-access-key>
