# Cloudflare R2 + Cloudflare Stream 配置样例
# 用法：复制为项目根的 cloudflare.env，填入真实值。该文件应加入 .gitignore，切勿提交。
#
# 需要：
#   CLOUDFLARE_ACCOUNT_ID
#   CLOUDFLARE_STREAM_API_TOKEN        Cloudflare API Token，至少包含 Stream Edit/Write
#   CLOUDFLARE_R2_PUBLIC_DOMAIN
#   CLOUDFLARE_R2_BUCKET
#   CLOUDFLARE_R2_PREFIX               可选，R2 子目录前缀
#   CLOUDFLARE_STREAM_ALLOWED_ORIGINS  可选，逗号分隔
#   CLOUDFLARE_STREAM_REQUIRE_SIGNED_URLS 可选，true/false

CLOUDFLARE_ACCOUNT_ID=<your-account-id>
CLOUDFLARE_STREAM_API_TOKEN=<your-cloudflare-api-token-with-stream-write>

CLOUDFLARE_R2_BUCKET=<bucket-name>
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-<hash>.r2.dev
CLOUDFLARE_R2_PREFIX=

CLOUDFLARE_R2_ACCESS_KEY=<r2-access-key-id>
CLOUDFLARE_R2_SECRET=<r2-secret-access-key>

CLOUDFLARE_STREAM_ALLOWED_ORIGINS=
CLOUDFLARE_STREAM_REQUIRE_SIGNED_URLS=false
