# Cloudflare R2 + Mux 配置样例
# 用法：复制为项目根的 cloudflare.env，填入真实值。该文件应加入 .gitignore，切勿提交。
#
# 脚本（mux_r2_nightly_pull.py / mux_upload.py）读取的字段：
#   - MUX_TOKEN_ID / MUX_TOKEN_SECRET          Mux API 令牌（也可用同名环境变量覆盖，环境变量优先）
#   - CLOUDFLARE_R2_PUBLIC_DOMAIN              拼出 Mux 拉取的公共 URL：<域名>/<文件名>
#   - CLOUDFLARE_R2_BUCKET                     rclone 列出桶内对象
# 其余字段供 rclone.conf 使用，保持两处一致即可。

MUX_TOKEN_ID=<Mux Access Token ID>
MUX_TOKEN_SECRET=<Mux Secret Key>

CLOUDFLARE_ACCOUNT_ID=<你的 R2 账户 ID>
CLOUDFLARE_R2_BUCKET=<桶名，例如 isee-videos>
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-<哈希>.r2.dev
CLOUDFLARE_R2_ACCESS_KEY=<R2 Access Key ID>
CLOUDFLARE_R2_SECRET=<R2 Secret Access Key>
